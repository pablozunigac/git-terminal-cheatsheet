# ==========================================
# 1. PRIVACY, SECURITY & CREDENTIALS
# ==========================================
# Secret files and local environment configs
.env
.env.*
!.env.example
!.env.template

# SSH keys, certificates, and private tokens
*.pem
*.key
*.crt
*.pfx
*.p12
*.pub
*_rsa
*_ed25519
id_*

# Cloud and CLI provider credentials
.aws/
.gcp/
.azure/

# ==========================================
# 2. MACOS SYSTEM & METADATA
# ==========================================
# Finder & filesystem artifacts
.DS_Store
.AppleDouble
.LSOverride
._*
.Trashes
.Spotlight-V100
.fseventsd

# Archival & compressed files
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ==========================================
# 3. EDITOR & IDE (VS Code & Terminal)
# ==========================================
# VS Code local workspace history & state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/cspell.json

# Vim / Neovim swap and backup files
*.swp
*.swo
*~
*.un~

# Other IDE directories
.idea/
.zed/

# ==========================================
# 4. TESTING, LINTING & AUTOMATION
# ==========================================
# Local testing, markdownlint, & shell script cache
.cache/
.markdownlint-cli2/
*.log
tmp/
temp/
*.tmp
*.bak

# Node.js dependencies (if markdownlint / prettier CLI run locally)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 5. DATA & LOCAL EXPORTS
# ==========================================
# Personal working files and data dumps
*.csv
*.xlsx
*.pdf
*.pages
data/
exports/